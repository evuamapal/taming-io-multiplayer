	#wg-unblock-outer {
		color-scheme: dark;
	}
}

#wg-unblock-backdrop {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: rgba(0, 0, 0, 0.5);
	z-index: 1000000;
	display: flex;
	justify-content: center;
	align-items: center;
}

#wg-unblock-outer {
	box-sizing: border-box;
	width: 700px;
	height: 500px;
}

#wg-unblock-inner {
	display: flex;
	flex-direction: column;
	box-shadow: rgba(0, 0, 0, 0.5) 0 4px 16px;
	border: 1px solid var(--wg-unblock-border);
	border-radius: 8px;
	background-color: var(--wg-unblock-background-0);
	height: 100%;
	overflow: hidden;
	color: var(--wg-unblock-text);
	font-family: sans-serif;
}

#wg-unblock-titlebar {
	display: flex;
	flex-shrink: 0;
	align-items: center;
	border-bottom: 1px solid var(--wg-unblock-border);
	background-color: var(--wg-unblock-background-1);
	height: 48px;
}

#wg-unblock-title {
	margin: 0 0 0 12px;
	font-size: 18px;
}

#wg-unblock-close {
	cursor: pointer;
	margin-left: auto;
	border: none;
	background-image: url("${_111}/img/unblock/interface/x.png");
	background-position: center;
	background-size: 32px 32px;
	background-repeat: no-repeat;
	background-color: var(--wg-unblock-negative-1);
	width: 48px;
	height: 100%;
}

#wg-unblock-close:hover {
	background-color: var(--wg-unblock-negative-0);
}

#wg-unblock-close:active {
	background-color: var(--wg-unblock-negative-2);
}

#wg-unblock-content {
	display: flex;
	flex-grow: 1;
	overflow: hidden;
}

#wg-unblock-list {
	display: flex;
	flex-shrink: 0;
	flex-direction: column;
	gap: 8px;
	border-right: 1px solid var(--wg-unblock-border);
	background-color: var(--wg-unblock-background-1);
	padding: 8px;
	width: 180px;
	overflow-y: scroll;
}

.wg-unblock-category {
	margin: 12px 0 0 4px;
	font-size: 14px;
}

.wg-unblock-category:first-of-type {
	margin: 0 0 0 4px;
}

.wg-unblock-item {
	display: flex;
	align-items: center;
	gap: 4px;
	cursor: pointer;
	border: none;
	border-radius: 4px;
	background: none;
	padding: 4px;
	color: inherit;
	font: inherit;
	text-align: left;
}

.wg-unblock-item:hover {
	background: var(--wg-unblock-hover);
}

.wg-unblock-item:active,
.wg-unblock-item.selected {
	background: var(--wg-unblock-selected);
}

#wg-unblock-page {
	display: flex;
	flex-direction: column;
}

#wg-unblock-page-content {
	padding: 8px;
	height: 100%;
	overflow-y: scroll;
}

#wg-unblock-page-content h3 {
	margin-top: 0;
}

.wg-unblock-video {
	float: right;
	border-radius: 4px;
	max-width: 220px;
	max-height: 400px;
}

#wg-unblock-page-controls {
	display: flex;
	flex-shrink: 0;
	align-items: center;
	gap: 4px;
	margin-top: auto;
	padding: 8px;
}

.wg-unblock-control {
	display: flex;
	justify-content: center;
	align-items: center;
	cursor: pointer;
	border: none;
	border-radius: 4px;
	background-color: var(--wg-unblock-background-1);
	width: 100%;
	height: 32px;
}

.wg-unblock-control:hover {
	background-color: var(--wg-unblock-hover);
}

.wg-unblock-control:active {
	background-color: var(--wg-unblock-selected);
}

#wg-unblock-reload {
	background-color: var(--wg-unblock-positive-1);
}

#wg-unblock-reload:hover {
	background-color: var(--wg-unblock-positive-0);
}

#wg-unblock-reload:active {
	background-color: var(--wg-unblock-positive-2);
}

#wg-unblock-back {
	display: none;
}

@media (max-width: 800px) {

	#wg-unblock-outer {
		padding: 10px;
		width: 100%;
		height: 100%;
	}

	#wg-unblock-back {
		display: flex;
	}

	#wg-unblock-page {
		display: none;
	}

	#wg-unblock-list {
		flex-grow: 1;
		border-right: none;
	}

	#wg-unblock-outer.expanded #wg-unblock-page {
		display: flex;
	}

	#wg-unblock-outer.expanded #wg-unblock-list {
		display: none;
	}

	.wg-unblock-video {
		display: block;
		float: none;
		margin: 0 auto;
	}
}
