.wg-ad-container {

	z-index: 1000000;
	width: 100%;
	height: 100%;
	position: fixed;
	top: 0;
	left: 0;
	bottom: 0;
	right: 0;
	margin: auto;
	background-color: #000000;
}

.wg-ad-player {

	width: 100%;
	height: calc(100% - 44px);
	display: none;
	cursor: pointer;
}

.wg-adplayer-skip {

	position: absolute;
	top: 20px;
	right: 20px;
	padding: 8px 16px;
	background-color: rgba(0, 0, 0, 0.7);
