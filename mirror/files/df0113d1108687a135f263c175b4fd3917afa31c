	background-color: #000000;
	position: absolute;
	bottom: 0;
	height: 44px;
}

.wg-adplayer-timeline-container {

	height: 2px;
	background-color: #808080;
	width: 100%;
	position: relative;
	top: -7px;
}

.wg-adplayer-timeline {

	width: 0%;
	background-color: #FFFFFF;
	height: 100%;
}

.wg-adplayer-time {

	color: #808080;
	margin: auto 20px;
	font-family: auto;
	margin-top: 2px;
}

.wg-adplayer-logo {

	width: 111px;
	height: 29px;
	margin-right: 20px;
	margin-top: -10px;
