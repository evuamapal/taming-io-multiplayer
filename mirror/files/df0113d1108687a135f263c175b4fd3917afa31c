	:root {
		--wg-unblock-text: #eeeeee;
		--wg-unblock-border: #3d424b;
		--wg-unblock-hover: #204f7f;
		--wg-unblock-background-0: #303136;
		--wg-unblock-background-1: #26262b;
		--wg-unblock-background-2: #17161a;
		--wg-unblock-positive-0: #6cc738;
		--wg-unblock-positive-1: #34a143;
		--wg-unblock-positive-2: #267544;
