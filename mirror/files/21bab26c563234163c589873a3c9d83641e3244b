	height: 100%;
	z-index: 1;
	display: none;
}

#inspect-background {
	position: absolute;
	animation: fade-in 0.5s cubic-bezier(0.25, 0, 0, 1) 1 forwards;
	background-color: rgba(58, 50, 43, 0.5);
	width: 100%;
	height: 100%;
}

#inspect-image {
	bottom: 150px;
