}

#rebind-key {
	--settings-panel: var(--brown2);
	--settings-tab: #8b4e29;
	--settings-tab-hover: #95552e;
	--settings-rule: #7d4320;
}

#rebind-key.settings-transparent {
	--settings-panel: #7c432066;
	--settings-tab: #8b4e2966;
	--settings-tab-hover: #95552e88;
}

/* Tabs */
#settings-tabs {
	display: flex;
	align-items: flex-end;
	flex-shrink: 0;
	height: 68px;
	margin: -18px 34px 0 108px;
}

.settings-tab {
	position: relative;
	box-sizing: border-box;
	flex: 1 1 0;
	min-width: 0;
	height: 61px;
	margin-right: 8px;
	padding-bottom: 6px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: flex-end;
	background: var(--settings-tab);
	border-radius: 12px 12px 0 0;
	cursor: url(../img/interface/cursor-pointer.png) 16 0, pointer;
	transition: height 120ms ease-out, background-color 120ms ease-out;
}

.settings-tab:last-child { margin-right: 0; }

.settings-tab:hover {
	height: 64px;
	background: var(--settings-tab-hover);
}

.settings-tab-icon {
	flex-shrink: 0;
	width: 30px;
	height: 30px;
	opacity: 0.8;
	transition: opacity 120ms ease-out;
}

.settings-tab-label {
	margin-top: 4px;
	font-size: 14px;
	line-height: 16px;
	white-space: nowrap;
	color: #ecd0a8;
}

.settings-tab:hover .settings-tab-icon { opacity: 1; }

.settings-tab-selected,
.settings-tab-selected:hover {
	z-index: 1;
	height: 68px;
	margin-bottom: -1px;
	padding-bottom: 7px;
	background: var(--settings-panel);
}

#rebind-key.settings-transparent .settings-tab-selected {
	margin-bottom: 0;
	padding-bottom: 6px;
}

.settings-tab-selected::before,
.settings-tab-selected::after {
	content: "";
	position: absolute;
	bottom: 0;
	width: 8px;
	height: 8px;
}

.settings-tab-selected::before {
	left: -8px;
	background: radial-gradient(circle at 0 0, transparent 7.5px, var(--settings-panel) 8px);
}

.settings-tab-selected::after {
	right: -8px;
	background: radial-gradient(circle at 100% 0, transparent 7.5px, var(--settings-panel) 8px);
}

.settings-tab-selected .settings-tab-icon { opacity: 1; }

.settings-tab-selected .settings-tab-label { color: var(--white); }

#settings-tab-mobile { display: none; }

/* Pages */
#settings-pages {
	flex: 1;
	min-height: 0;
	overflow-x: hidden;
	overflow-y: auto;
	padding: 14px 12px 12px 12px;
	background: var(--settings-panel);
	border-radius: 10px;
}

.settings-page {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10px;
}

.settings-page-fill {
	display: flex;
	flex-direction: column;
	min-height: 100%;
}

.settings-card-fill {
	display: flex;
	flex-direction: column;
	flex-grow: 1;
}

.settings-card-fill > .settings-grid {
	display: flex;
	flex-grow: 1;
}

.settings-card-fill > .settings-grow-2 { flex-grow: 2; }

.settings-card-fill > .settings-grow-3 { flex-grow: 3; }

.settings-group {
	flex: 1 1 0;
	min-width: 0;
	display: flex;
	flex-direction: column;
}

.settings-group > .settings-row {
	flex: 1 1 0;
	min-height: 48px;
}

.settings-row + .settings-row-blank { border-top-color: transparent; }

.settings-page-center {
	display: flex;
	flex-direction: column;
	align-items: center;
	min-height: 100%;
}

.settings-page-center > .settings-card {
	box-sizing: border-box;
	width: 100%;
	max-width: 600px;
	text-align: center;
}

.settings-page-center > .settings-card:first-child { margin-top: auto; }

.settings-page-center > .settings-card:last-child { margin-bottom: auto; }

.settings-card {
	position: relative;
	min-width: 0;
	padding: 10px 16px 8px 16px;
	background: var(--brown3);
	border-radius: 10px;
	counter-reset: settings-on settings-all;
}

.settings-card-wide { grid-column: 1 / -1; }

.settings-card-title {
	margin: 0 -8px 4px -8px;
	padding: 1px 10px 3px 10px;
	font-size: 20px;
	line-height: 28px;
	background: var(--brown4);
	border-radius: 7px;
}

.settings-count {
	position: absolute;
	top: 18px;
	right: 18px;
	font-size: 13px;
	line-height: 16px;
	color: var(--beige1);
}

.settings-count::after { content: counter(settings-on) " / " counter(settings-all) " on"; }

#settings-pages .activate-line { counter-increment: settings-all; }

#settings-pages .activate-line-on { counter-increment: settings-all settings-on; }

.settings-subtitle {
	padding: 4px 0;
	font-size: 14px;
}

.settings-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	grid-auto-flow: column;
	column-gap: 44px;
	background-image: linear-gradient(90deg, transparent calc(50% - 1px), var(--settings-rule) calc(50% - 1px),
		var(--settings-rule) calc(50% + 1px), transparent calc(50% + 1px));
	background-repeat: no-repeat;
	background-position: center;
	background-size: 100% calc(100% - 12px);
}

.settings-rows-1 { grid-template-rows: repeat(1, auto); }
.settings-rows-3 { grid-template-rows: repeat(3, auto); }
.settings-rows-5 { grid-template-rows: repeat(5, auto); }
.settings-rows-7 { grid-template-rows: repeat(7, auto); }

.settings-grid-single { background-image: none; }

.settings-card-movement {
	display: flex;
	flex-direction: column;
}

.settings-arrows {
	display: grid;
	grid-template-columns: repeat(3, 86px);
	justify-content: center;
	row-gap: 6px;
	margin: auto -8px;
	padding: 14px 10px 10px 10px;
	background: var(--brown4);
	border-radius: 14px;
	box-shadow: inset 0 5px 0 rgba(0, 0, 0, 0.15);
}

.settings-arrow {
	display: flex;
	flex-direction: column;
	align-items: center;
}

.settings-arrow-up { grid-column: 2; }

.settings-arrow:not(.settings-arrow-up) { grid-row: 2; }

.settings-arrow-label {
	margin-top: 4px;
	font-size: 14px;
	line-height: 16px;
}

.settings-arrow-label::before {
	content: "";
	display: inline-block;
	margin-right: 5px;
	vertical-align: 1px;
	border: 5px solid transparent;
}

.settings-arrow-up .settings-arrow-label::before {
	border-top-width: 0;
	border-bottom: 7px solid var(--beige);
}

.settings-arrow-left .settings-arrow-label::before {
	border-left-width: 0;
	border-right: 7px solid var(--beige);
}

.settings-arrow-down .settings-arrow-label::before {
	border-bottom-width: 0;
	border-top: 7px solid var(--beige);
}

.settings-arrow-right .settings-arrow-label::before {
	border-right-width: 0;
	border-left: 7px solid var(--beige);
}

.settings-movement-hint {
	margin-bottom: 2px;
	font-size: 12px;
	line-height: 14px;
	text-align: center;
	color: var(--beige1);
}

.settings-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 46px;
	padding: 3px 0;
	font-size: 16px;
}

.settings-row + .settings-row { border-top: 2px solid var(--settings-rule); }

.settings-rows-1 > .settings-row:nth-child(2),
.settings-rows-3 > .settings-row:nth-child(4),
.settings-rows-5 > .settings-row:nth-child(6),
.settings-rows-7 > .settings-row:nth-child(8) { border-top: 0; }

.settings-row-icon {
	flex-shrink: 0;
	width: 32px;
	height: 36px;
	margin-right: 10px;
}

.settings-label {
	flex: 1;
	min-width: 0;
	margin-right: 12px;
	line-height: 19px;
}

.settings-hint {
	display: block;
	margin-top: 1px;
	font-size: 12px;
	line-height: 14px;
	color: var(--beige1);
	text-shadow: none;
}

.settings-row .activate-box {
	flex-shrink: 0;
	margin: 0 10px;
}

.settings-key-row { cursor: url(../img/interface/cursor-pointer.png) 16 0, pointer; }

#settings-pages .popup-input {
	flex-shrink: 0;
	margin: 0;
}

.settings-key-locked { filter: grayscale(1); }

.settings-plus {
	margin-left: 8px;
	padding: 0 10px;
	font-size: 30px;
	line-height: 40px;
	background: var(--black);
	border-radius: 7px;
}

#items > .settings-card-title { margin: 0 0 0 -8px; }

.settings-slots { display: flex; }

#settings-pages .settings-slots .popup-input {
	width: 35px;
	margin-left: 4px;
}

#settings-pages .settings-slots .settings-slots-split { margin-left: 22px; }

.settings-card-resolution {
	display: flex;
	flex-direction: column;
}

.settings-resolution {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin: auto 0;
	padding: 4px 18px 8px 0;
}

.settings-resolution-label {
	display: flex;
	flex-direction: column;
	justify-content: center;
	height: 50px;
	font-size: 16px;
	line-height: 19px;
}

.settings-resolution-label.clickable:hover { color: var(--yellow0); }

.settings-resolution-slot {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 50px;
}

.settings-resolution-slot .white-circle { flex-shrink: 0; }

/* Device */
.settings-device {
	margin-top: 6px;
	padding-top: 8px;
	border-top: 2px solid var(--settings-rule);
	font-size: 13px;
	line-height: 17px;
}

.settings-device-title {
	display: flex;
	justify-content: space-between;
	margin-bottom: 4px;
	font-size: 14px;
}

#settings-device-version { color: var(--beige1); }

.settings-device-row {
	display: flex;
	padding: 2px 0;
}

.settings-device-name {
	flex-shrink: 0;
	width: 92px;
	color: var(--beige);
}

.settings-device-value {
	flex: 1;
	min-width: 0;
	overflow-wrap: anywhere;
	-webkit-user-select: text;
	-moz-user-select: text;
	user-select: text;
}

#settings-device-warning {
	margin-top: 4px;
	color: var(--orange0);
}

.settings-note {
	grid-column: 1 / -1;
	padding: 0 6px;
	font-size: 13px;
}

.settings-actions {
	display: flex;
	justify-content: center;
	padding: 12px 16px;
}

.settings-button {
	flex-shrink: 0;
	width: auto;
	height: 34px;
	padding: 6px 18px 0 18px;
	font-size: 17px;
	white-space: nowrap;
}

/* Backup */
.settings-text {
	margin: 2px 0 10px 0;
	font-size: 14px;
	line-height: 18px;
}

.settings-buttons { display: flex; }

.settings-buttons .settings-button {
	flex: 1;
	margin-right: 12px;
}

.settings-buttons .settings-button:last-child { margin-right: 0; }

.settings-file-button {
	position: relative;
	overflow: hidden;
}

#settings-import-file {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	opacity: 0;
	font-size: 0;
	cursor: url(../img/interface/cursor-pointer.png) 16 0, pointer;
}

#settings-import-text {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 86px;
	margin-bottom: 10px;
	padding: 8px 10px;
	resize: none;
	outline: none;
	border: 5px solid var(--black);
	border-radius: 10px;
	background: #ffe6c2;
	box-shadow: inset 0px 5px 0px #e0c6a0;
	color: var(--black);
	font-size: 13px;
	line-height: 17px;
	text-align: left;
	-webkit-user-select: text;
	-moz-user-select: text;
	user-select: text;
}

.settings-status {
	min-height: 22px;
	margin-top: 8px;
	font-size: 14px;
	text-align: center;
}

.settings-status-ok { color: var(--green0); }

.settings-status-error { color: var(--red0); }

/* ---- Cosmetics ---- */
img.lights {
	width: unset;
}

.get-premium-button {
	position:relative;
	background: var(--yellow3);
	padding: 15px;
	width: 180px;
	box-shadow: inset 0 -5px 0 var(--orange1);
}

.get-premium-button:hover {
	background: var(--yellow1);
	box-shadow: inset 0 -5px 0 var(--orange0);
}

.get-premium-button:active {
	margin-top:5px;
	background: var(--orange1);
	box-shadow: none;
}

/* ---- Tamodex ----- */
.unlock-pet-button {
	padding: 5px 0 15px 0;
	width: 230px;
	border-radius: 8px;
	height: 16px;
}

.unlock-pet-button:active {
	margin: 0;
	height: 13px;
	padding-top: 8px;
}

.tamodex-custom-button {
	border-radius: 8px 8px 0 0;
	cursor: url(../img/interface/cursor-pointer.png) 16 0, pointer;
}

.tamodex-custom-button:active, .tamodex-custom-selected, .tamodex-custom-selected:hover, .tamodex-custom-selected:active {
	cursor: url(../img/interface/cursor-default.png) 4 0, default;
	box-shadow: none;
}

.tamodex-custom-button, .tamodex-custom-button:active, .tamodex-custom-selected,
.tamodex-custom-selected:hover, .tamodex-custom-selected:active {
	height: 41px; width:41px;
	padding: 5px;
	background: var(--black);
}

.staging-change-pet {
	bottom: 5px;
	justify-content: center;
	width: 180px;
	position: absolute;
}

.locked-card {
	width: 167px;
	height: 370px;
	background: var(--brown4);
	text-align: center;
	border: 30px solid #613011;
	border-radius: 10px;
	font-size: 20px;
	filter: grayscale(0.6);
}

.staging-trinkets {
	position: absolute;
	top: 8px;
	left: 8px;
	width: 175px;
	margin: auto;
	display: flex;
	gap: 5px;
	z-index: 1;
}

.staging-trinket {
	width: 35px;
	height: 35px;
	background: var(--black);
	border-radius: 8px;
	box-shadow: inset 0 -5px 0 #23221f;
	cursor: url(../img/interface/cursor-pointer.png) 16 0, pointer;
	transition: transform 100ms;
	image-rendering: -webkit-optimize-contrast;
	display: flex;
	justify-content: center;
	align-items: center;
	border: none;
}

.staging-trinket img {
	width: 55px;
	height: 55px;
	transform: rotate(27deg);
	margin: -14px -9px -9px;
	pointer-events: none;
}

.staging-trinket:hover { background: var(--black1); }

.staging-trinkets-tooltip { display: none; }

.staging-trinkets:hover > .staging-trinkets-tooltip {
	width: 254px;
	border-radius: 8px;
	position: absolute;
	left: -10px;
	top: -67px;
	display: inline-block;
	animation: tooltip 300ms 1 ease;
	z-index: 1;
}

/* ---- Housing ---- */

#housing {
	display: none;
	width: 100%;
	overflow: hidden;
}

#housing-top {
	position: absolute;
	top: 0;
	right: 0;
	left: 0;
	gap: 0 10px;
	box-sizing: border-box;
	margin: auto;
	background: url("../img/interface/housing-top-middle.png");
	background-size: 100% 100%;
	padding-top: 30px;
	width: 830px;
	height: 56px;
	z-index: 1;
}

#housing-top:after, #housing-top:before {
	position: absolute;
	top: 0;
	background-size: 100% 100%;
	width: 95px;
	height: 100%;
	content: "";
}

#housing-top:before { left: -95px; background-image: url("../img/interface/housing-top-left.png");}
#housing-top:after { right: -95px; background-image: url("../img/interface/housing-top-right.png"); }

#housing-top .top-button {
	display: flex;
	position: relative;
	box-sizing: content-box;
	background-clip: padding-box; /* Firefox rendering bug workaround */
	padding: 0;
	width: 55px;
	height: 55px;
}

#housing-top button img {
	max-width: 100%;
	max-height: 100%;
}

#housing-top button .tooltip {
	display: none;
	position: absolute;
	bottom: -60px;
	z-index: 1;
	width: max-content;
	pointer-events: none;
	color: var(--white);
	font-size: 16px;
	white-space: nowrap;
}

#housing-top button:hover .tooltip {
	display: inline-block;
	animation: tooltip 300ms 1 ease;
}

#housing-title {
	position: relative;
	background-image: url("../img/interface/housing-title.png");
	background-size: 100% 100%;
	width: 300px;
	height: 75px;
}

#housing-title-input {
	position: absolute;
	right: 0;
	bottom: 0;
	left: 0;
	cursor: url("../img/interface/cursor-text.png") 16 0, text;
	margin: 0 13px;
	border: none;
	border-radius: 0 0 32px 32px;
	background: none;
	height: 50px;
	color: var(--white);
	font-size: 20px;
	line-height: 51px;
	text-align: center;
}

#housing-title-input[disabled] {
	cursor: inherit;
}

#housing-title-input:focus {
	color: var(--beige);
}

#housing-title button {
	position: relative;
	border: none;
	background: none;
	width: 42px;
	height: 42px;
}

button#housing-title-heart {
	position: absolute;
	top: 0;
	left: 0;
	opacity: 0;
}

button#housing-title-heart .tooltip::after { content: "Like"; }
button#housing-title-heart:has(img#housing-title-unlike[style*="display: flex"]) .tooltip::after {
  content: "Unlike";
}

button#housing-title-edit {
	position: absolute;
	top: 0;
	right: 0;
	opacity: 0;
}

.heart-count {
	font-size: 15px;
	position: absolute;
	left: 24px;
	transform: rotate(-39deg);
	top: 22px;
}

button#housing-title-lock {
	position: absolute;
	top: 0;
	left: 0;
	opacity: 0;
	background: url("../img/interface/construction-unlocked.png") center / 100%;
	display: none;
}

button#housing-title-lock.lock {
	background-image: url("../img/interface/construction-locked.png");
}

#housing-title:hover #housing-title-edit,
button#housing-title-edit:focus,
#housing-title:hover #housing-title-heart,
button#housing-title-locks:focus,
#housing-title:hover #housing-title-lock,
button#housing-title-lock:focus {
	opacity: 1;
}

#housing-title-unlike {

	display: none;
}

#housing-editing {
	position: absolute;
	right: 0;
	bottom: -50px;
	left: 0;
	gap: 10px;
	animation: tooltip 300ms 1 ease;
	margin: auto;
	width: 150px;
}

@media (max-width: 830px) {
	#housing-top {
		width: 510px;
	}

	#housing-title {
		display: none;
	}
}

/* ---- Quests in Housing ---- */

#housing-quests {
	position: absolute;
	top: 100px;
	right: 0;
	gap: 10px;
	z-index: 1;
	transition: transform 500ms cubic-bezier(0.25, 0, 0, 1);
	transform: translateX(300px);
	z-index: 200;
}

#housing-quests:hover,
#housing-quests:focus {
	transform: translateX(0);
}

.housing-quest {
	display: flex;
	position: relative;
	flex-shrink: 0;
	align-items: center;
	gap: 10px;
	box-sizing: border-box;
	padding: 5px 0 9px 30px;
	width: 400px;
	height: 80px;
}

.housing-quest-background {
	position: absolute;
	top: 0;
	left: 0;
	z-index: -1;
	background-image: url("../img/interface/housing-quest.png");
	background-size: 400px 80px;
	width: 100%;
	height: 100%;
}

.housing-quest-progress {
	transition: width 500ms cubic-bezier(0.25, 0, 0, 1);
	background-image: url("../img/interface/housing-quest-value.png");
	background-size: 400px 80px;
	width: 100%;
	height: 100%;
}

.housing-quest-title {
	color: var(--black);
	font-size: 18px;
}

.housing-quest-description {
	color: var(--black);
	font-weight: 300;
	font-size: 16px;
}

.housing-quest-done {
	cursor: url("../img/interface/cursor-pointer.png") 16 0, pointer;
}

.housing-quest-done:active {
	padding: 9px 0 5px 30px;
}

/* ---- Rewards of a claimed quest, shown together in the reward message box ---- */

/* The box spreads over the 50px padding of the message panel, so the lit background fills the panel edge to edge */
.housing-quest-rewards {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;
	margin: -50px;
	padding: 10px 20px 14px;
}

/* The tilted gift pattern of the adventure chests, wide enough to cover the panel corners, the panel clips the rest */
.housing-quest-rewards-background {
	position: absolute;
	top: 50%; left: 50%;
	width: 640px; height: 540px;
	margin: -270px 0 0 -320px;
	background-image: url(../img/background-reward.png);
	background-color: var(--brown2);
	background-blend-mode: color-dodge;
	opacity: 0.7;
	transform: rotate(340deg);
	animation: background-position 75s infinite linear;
}

.housing-quest-rewards-light {
	position: absolute;
	top: 50%; left: 50%;
	width: 400px; height: 400px;
	margin: -200px 0 0 -200px;
	pointer-events: none;
	animation: rotate 10s infinite linear;
}

.housing-quest-rewards-title {
	position: relative;
	margin: 0;
	padding: 3px 18px;
	background: var(--black);
	border-radius: 5px;
	font-size: 22px;
}

.housing-quest-rewards-quest {
	position: relative;
	margin: 0 0 6px;
	font-size: 18px;
	color: var(--beige);
}

/* Three tiles at most side by side, a quest grants up to three rewards */
.housing-quest-reward-list {
	position: relative;
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 20px;
}

.housing-quest-reward {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 130px;
}

.housing-quest-reward-card {
	width: 130px; height: 130px;
}

.housing-quest-reward-image {
	position: absolute;
	top: 14px; left: 0; right: 0;
	margin: auto;
	width: 102px; height: 102px;
	object-fit: contain;
	border-radius: 9px;
}

.housing-quest-reward-paper {
	position: absolute;
	top: 14px; left: 0; right: 0;
	margin: auto;
	width: 102px; height: 102px;
	background: url("../img/interface/furniture-blueprint.png") center / 100% 100% no-repeat;
}

.housing-quest-reward-image-blueprint {
	top: 27px;
	width: 76px; height: 76px;
}

/* A lone reward takes the card size of the adventure chests */
.housing-quest-reward:only-child {
	width: 150px;
}

.housing-quest-reward:only-child .housing-quest-reward-card {
	width: 150px; height: 150px;
}

.housing-quest-reward:only-child .housing-quest-reward-image,
.housing-quest-reward:only-child .housing-quest-reward-paper {
	top: 16px;
	width: 118px; height: 118px;
}

.housing-quest-reward:only-child .housing-quest-reward-image-blueprint {
	top: 31px;
	width: 88px; height: 88px;
}

.housing-quest-reward-amount {
	position: absolute;
	top: -8px; right: -8px;
	padding: 3px 8px;
	background: var(--black);
	border-radius: 9px;
	color: var(--yellow0);
	font-size: 15px;
}

.housing-quest-reward-type {
	margin: 6px 0 0;
	padding: 2px 8px;
	background: var(--black);
	border-radius: 5px;
	font-size: 11px;
	letter-spacing: 1px;
}

.housing-quest-reward-name {
	margin: 4px 0 0;
	font-size: 16px;
	line-height: 1.15;
	text-align: center;
}

.housing-quest-reward-rarity {
	margin: 2px 0 0;
	font-size: 13px;
	color: var(--beige);
}

.housing-quest-done .housing-quest-progress {
	display: none;
}

.housing-quest-done .housing-quest-image {
	animation: crazy infinite linear 500ms;
}

.housing-quest-done .housing-quest-background {
	background-image: url("../img/interface/housing-quest-done.png");
}

.housing-quest-done:hover .housing-quest-background {
	background-image: url("../img/interface/housing-quest-done-hover.png");
}

.housing-quest-done:active .housing-quest-background {
	background-image: url("../img/interface/housing-quest-done-active.png");
}

#housing-quests.peek {
	transform: translateX(0);
}

/* ---- Housing Homepage ---- */
#housing-button { width: auto; position: relative; }

#housing-button img {
	width: 46px;
	margin: -5px 0 0 0;
}

#housing-button.alert::after { right: -4px; top: -12px; display: block; }

#housing-button::after { display: none; }

