	gap: 10px;
}

.base-editor-tiling-field {
	display: flex;
	align-items: center;
	gap: 6px;
	color: var(--white);
	font-size: 16px;
}

.base-editor-tiling-field input {
	box-sizing: border-box;
	width: 62px;
	height: 38px;
	border: 4px solid var(--black);
	border-radius: 9px;
	background: var(--beige1);
	box-shadow: inset 0 5px 0 #e0c6a0;
	color: var(--black);
	font-size: 16px;
	text-align: center;
	cursor: url("../img/interface/cursor-text.png") 16 0, text;
}

.base-editor-tiling-field input::-webkit-outer-spin-button,
.base-editor-tiling-field input::-webkit-inner-spin-button {
	-webkit-appearance: none;
	margin: 0;
}

.base-editor-tiling-field input[type="number"] {
	-moz-appearance: textfield;
	appearance: textfield;
}

#base-editor-tiling-hint {
	margin: 0;
	text-align: center;
	font-size: 13px;
	opacity: 0.75;
}

#base-editor-tiling-apply {
	padding: 5px 40px 10px 40px;
	font-size: 17px;
}

.base-editor-area-row {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 16px;
	padding: 9px 16px;
	margin-bottom: 6px;
	border-radius: 10px;
	background: var(--brown2);
	box-shadow: inset 0 -4px 0 var(--brown4);
}

.base-editor-area-row:hover { background: var(--brown1); }

.base-editor-area-label {
	color: var(--white);
	font-size: 17px;
}

.base-editor-area-settings-end {
	margin-bottom: 16px;
}

.base-editor-area-section {
	margin: 10px 0 8px 4px;
	color: var(--white);
	font-size: 15px;
	letter-spacing: 1px;
	text-transform: uppercase;
	opacity: 0.85;
}

.base-editor-area-hint {
	margin: 2px 0 12px 0;
	text-align: center;
	color: var(--white);
	font-size: 13px;
	line-height: 1.3;
	opacity: 0.75;
}

.base-editor-area-slider {
	position: relative;
	box-sizing: border-box;
	width: 150px;
	height: 22px;
	border: 5px solid var(--black);
	border-radius: 11px;
	background: var(--beige1);
	box-shadow: inset 0 5px 0 #e0c6a0;
	cursor: url("../img/interface/cursor-pointer.png") 16 0, pointer;
	touch-action: none;
}

.base-editor-area-slider-fill {
	position: absolute;
	top: 0;
	bottom: 0;
	left: 0;
	min-width: 6px;
	border-radius: 6px 0 0 6px;
	background: var(--green1);
	box-shadow: inset 0 4px 0 var(--green0);
	pointer-events: none;
}

.base-editor-area-slider-knob {
	position: absolute;
	top: 50%;
	left: 0;
	transform: translate(-50%, -50%);
	box-sizing: border-box;
	width: 28px;
	height: 28px;
	border: 5px solid var(--black);
	border-radius: 20px;
	background: var(--green1);
	box-shadow: inset -1px -6px 0 var(--green3);
	pointer-events: none;
}

.base-editor-admin-input-row {
	display: flex;
	align-items: center;
	gap: 10px;
	margin-bottom: 10px;
}

.base-editor-admin-input {
	flex: 1;
	min-width: 0;
	box-sizing: border-box;
	height: 42px;
	padding: 0 12px;
	border: 4px solid var(--black);
	border-radius: 9px;
	background: var(--beige1);
	box-shadow: inset 0 5px 0 #e0c6a0;
	color: var(--black);
	font-size: 16px;
	cursor: url("../img/interface/cursor-text.png") 16 0, text;
}

.base-editor-admin-input::placeholder {
	color: var(--brown1);
	opacity: 0.6;
}

.base-editor-admin-add {
	flex-shrink: 0;
	padding: 4px 14px 9px 14px;
	font-size: 15px;
}

.base-editor-admin-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	margin-bottom: 8px;
}

.base-editor-admin-tag {
	display: inline-flex;
	align-items: center;
	gap: 4px;
	box-sizing: border-box;
	max-width: 100%;
	padding: 3px 4px 5px 8px;
	border: 2px solid var(--brown4);
	border-radius: 4px;
	background: var(--beige1);
	box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.18);
	color: var(--black);
	font-size: 13px;
	line-height: 1;
	white-space: nowrap;
}

.base-editor-admin-tag-remove {
	border: 0;
	padding: 0 4px;
	background: transparent;
	color: var(--brown2);
	font-size: 17px;
	line-height: 1;
	cursor: url("../img/interface/cursor-pointer.png") 16 0, pointer;
}

.base-editor-admin-tag-remove:hover { color: var(--red1); }

.base-editor-admin-visitor {
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.base-editor-admin-kick {
	flex-shrink: 0;
	padding: 3px 12px 8px 12px;
	font-size: 14px;
}

#base-editor-map-popup {
	left: calc(50% - 222px);
	top: calc(50% - 258px);
	width: 444px;
	height: 516px;
	transform: scale(0);
	transition: transform 300ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
	z-index: 2;
}

#base-editor-map-frame {
	position: relative;
	flex-shrink: 0;
	margin: 64px auto 0 auto;
	width: 400px;
	height: 400px;
	border-radius: 10px;
	background: var(--black);
	box-shadow: inset 0 -4px 0 var(--brown4);
	overflow: hidden;
}

#base-editor-map-canvas {
	display: block;
	width: 400px;
	height: 400px;
	cursor: url("../img/interface/cursor-pointer.png") 16 0, pointer;
	touch-action: none;
}

#base-editor-map-overlay {
	position: absolute;
	top: 0;
	left: 0;
	width: 400px;
	height: 400px;
	pointer-events: none;
}

#base-editor-map-marker,
.base-editor-map-player {
	position: absolute;
	top: 0;
	left: 0;
	max-width: 12px;
	max-height: 12px;
	pointer-events: none;
}

#base-editor-map-marker:not([src]),
.base-editor-map-player:not([src]) {
	box-sizing: border-box;
	width: 6px;
	height: 6px;
	border: 1px solid var(--white);
	border-radius: 50%;
	background: var(--green1);
}

.base-editor-map-player:not([src]) {
	background: var(--red1);
}

#base-editor-map-coordinates {
	display: none;
	position: absolute;
	top: 6px;
	left: 8px;
	margin: 0;
	color: var(--white);
	font-size: 13px;
	pointer-events: none;
}

#base-editor-map-tools {
	position: absolute;
	top: 0;
	left: 0;
	gap: 0 6px;
}

#base-editor-map-tools .base-editor-map-tool {
	display: flex;
	position: relative;
	box-sizing: content-box;
	background-clip: padding-box;
	padding: 0;
	width: 34px;
	height: 34px;
}

#base-editor-map-tools button img {
	max-width: 100%;
	max-height: 100%;
}

#base-editor-map-tools button .tooltip {
	display: none;
	position: absolute;
	top: calc(100% + 12px);
	z-index: 1;
	width: max-content;
	pointer-events: none;
	color: var(--white);
	font-size: 13px;
	white-space: nowrap;
}

#base-editor-map-tools.base-editor-map-tooltip-above button .tooltip {
	top: auto;
	bottom: calc(100% + 12px);
}

#base-editor-map-tools button:hover .tooltip {
	display: inline-block;
	animation: tooltip 300ms 1 ease;
}

/* ------- HUD Editor ------- */

#hud-editor {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 21;
	touch-action: none;
	user-select: none;
	-webkit-user-select: none;
	cursor: url("../img/interface/cursor-default.png") 4 0, default;
}

.hud-editor-frame {
	position: absolute;
	top: 0;
	left: 0;
	box-sizing: border-box;
	border: 3px dashed rgba(255, 229, 193, 0.6);
	border-radius: 9px;
	background: rgba(58, 50, 43, 0.12);
	cursor: url("../img/interface/cursor-grab.png") 16 0, grab;
	touch-action: none;
	will-change: transform;
}

.hud-editor-frame:hover {
	border-color: var(--yellow0);
	background: rgba(239, 213, 97, 0.12);
}

.hud-editor-frame.hud-editor-selected {
	border-style: solid;
	border-color: var(--green0);
	background: rgba(200, 230, 83, 0.12);
}

.hud-editor-frame.hud-editor-dragging {
	cursor: url("../img/interface/cursor-grabbing.png") 16 0, grabbing;
	background: rgba(200, 230, 83, 0.2);
}

.hud-editor-frame.hud-editor-hidden,
.hud-editor-frame.hud-editor-hidden:hover,
.hud-editor-frame.hud-editor-hidden.hud-editor-selected {
	border-style: dotted;
	background-image: repeating-linear-gradient(-45deg, rgba(58, 50, 43, 0.22) 0 6px, transparent 6px 12px);
}

.hud-editor-frame.hud-editor-hidden .hud-editor-frame-label::after {
	content: " (hidden)";
	opacity: 0.75;
}

.hud-editor-frame-label {
	position: absolute;
	top: -27px;
	left: -3px;
	padding: 3px 9px 4px 9px;
	border-radius: 7px 7px 7px 0;
	background: var(--black);
	color: var(--white);
	font-size: 13px;
	line-height: 17px;
	white-space: nowrap;
	pointer-events: none;
}

.hud-editor-frame.hud-editor-label-inside .hud-editor-frame-label {
	top: 3px;
	left: 3px;
	border-radius: 6px 0 7px 0;
}

.hud-editor-frame:hover .hud-editor-frame-label { color: var(--yellow0); }
.hud-editor-frame.hud-editor-selected .hud-editor-frame-label { color: var(--green0); }

.hud-editor-frame.hud-editor-child .hud-editor-frame-label { display: none; }

.hud-editor-frame.hud-editor-child:hover .hud-editor-frame-label,
.hud-editor-frame.hud-editor-child.hud-editor-selected .hud-editor-frame-label { display: block; }

.hud-editor-handle {
	position: absolute;
	right: -10px;
	bottom: -10px;
	box-sizing: border-box;
	width: 18px;
	height: 18px;
	border: 4px solid var(--black);
	border-radius: 5px;
	background: var(--yellow0);
	box-shadow: inset 0 -3px 0 var(--yellow2);
	cursor: url("../img/interface/cursor-grab.png") 16 0, nwse-resize;
	touch-action: none;
}

.hud-editor-handle:hover { background: var(--white); }

.hud-editor-frame.hud-editor-selected .hud-editor-handle {
	background: var(--green0);
	box-shadow: inset 0 -3px 0 var(--green2);
}

#hud-editor-panel {
	left: calc(50% - 166px);
	top: calc(50% - 190px);
	width: 320px;
	transform: scale(0);
	transition: transform 300ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
	z-index: 1001;
	cursor: url("../img/interface/cursor-default.png") 4 0, default;
}

#hud-editor-panel .storage-title {
	width: 220px;
	white-space: nowrap;
}

.hud-editor-content {
	margin: 62px 20px 18px 20px;
	gap: 10px;
}

.hud-editor-selection {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
	padding: 9px 16px;
	border-radius: 10px;
	background: var(--brown2);
	box-shadow: inset 0 -4px 0 var(--brown4);
	font-size: 16px;
}

.hud-editor-selection-title { opacity: 0.8; }

.hud-editor-name {
	font-size: 17px;
	text-align: right;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.hud-editor-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	box-sizing: border-box;
	padding: 9px 16px;
	border-radius: 10px;
	background: var(--brown2);
	box-shadow: inset 0 -4px 0 var(--brown4);
}

.hud-editor-row.clickable:hover { background: var(--brown1); }

.hud-editor-label {
	flex-shrink: 0;
	font-size: 16px;
}

.hud-editor-value {
	flex-shrink: 0;
	width: 46px;
	text-align: right;
	font-size: 15px;
	color: var(--yellow0);
}

.hud-editor-slider {
	position: relative;
	flex-grow: 1;
	box-sizing: border-box;
	height: 22px;
	border: 5px solid var(--black);
	border-radius: 11px;
	background: var(--beige1);
	box-shadow: inset 0 5px 0 #e0c6a0;
	cursor: url("../img/interface/cursor-pointer.png") 16 0, pointer;
	touch-action: none;
}

.hud-editor-slider-fill {
	position: absolute;
	top: 0;
	bottom: 0;
	left: 0;
	min-width: 6px;
	border-radius: 6px 0 0 6px;
	background: var(--green1);
	box-shadow: inset 0 4px 0 var(--green0);
	pointer-events: none;
}

.hud-editor-slider-knob {
	position: absolute;
	top: 50%;
	left: 0;
	transform: translate(-50%, -50%);
	box-sizing: border-box;
	width: 28px;
	height: 28px;
	border: 5px solid var(--black);
	border-radius: 20px;
	background: var(--green1);
	box-shadow: inset 0 -4px 0 var(--green2);
	pointer-events: none;
}

.hud-editor-slider.hud-editor-disabled {
	opacity: 0.45;
	cursor: url("../img/interface/cursor-default.png") 4 0, default;
}

.hud-editor-slider.hud-editor-disabled .hud-editor-slider-knob,
.hud-editor-slider.hud-editor-disabled .hud-editor-slider-fill { visibility: hidden; }

.hud-editor-lock-state {
	flex-grow: 1;
	text-align: right;
	font-size: 15px;
	color: var(--yellow0);
}

.hud-editor-lock-icon {
	flex-shrink: 0;
	width: 42px;
	height: 42px;
	background: url("../img/interface/construction-locked.png") center / 100% no-repeat;
}

.hud-editor-lock-icon.hud-editor-unlocked {
	background-image: url("../img/interface/construction-unlocked.png");
}

.hud-editor-row.hud-editor-disabled {
	opacity: 0.45;
	cursor: url("../img/interface/cursor-default.png") 4 0, default;
}

.hud-editor-actions { gap: 8px; }

.hud-editor-button {
	flex-grow: 1;
	box-sizing: border-box;
	height: 42px;
	padding: 0 6px 4px 6px;
	border: 5px solid var(--black);
	font-size: 15px;
	line-height: 1;
	white-space: nowrap;
	cursor: url("../img/interface/cursor-pointer.png") 16 0, pointer;
}

.hud-editor-button:active { padding: 4px 6px 0 6px; }

.hud-editor-button.hud-editor-disabled {
	filter: grayscale(1);
	opacity: 0.5;
	cursor: url("../img/interface/cursor-default.png") 4 0, default;
}

.hud-editor-hint {
	margin: 4px 2px 0 2px;
	font-size: 12px;
	line-height: 16px;
	text-align: center;
	opacity: 0.8;
}

.hud-editor-open-error {
	display: none;
	width: 100%;
	margin: 0 0 6px 0;
	font-size: 12px;
	line-height: 16px;
	text-align: center;
}
