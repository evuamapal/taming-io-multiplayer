# nginx in front of the game server (TLS certificates are yours, e.g. from certbot).
# X-Forwarded-For must be the client address only ($remote_addr), never the client-supplied chain:
# the server rate-limits on the first hop.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
	listen 443 ssl http2;
	server_name play.example.com;
	ssl_certificate     /etc/letsencrypt/live/play.example.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/play.example.com/privkey.pem;
	location / {
		proxy_pass http://127.0.0.1:8920;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_read_timeout 1h;
	}
}
